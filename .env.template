# Settings for the omp email bridge. ./install.sh fills these in for you.
# To set them by hand, copy the lines below into ~/.omp/agent/.env (the .env file in your omp agent
# directory) or export them in your shell. Values set in the shell take precedence over the file.

# Mailtrap API token with admin access to your account: https://mailtrap.io/settings/api-tokens
MAILTRAP_API_TOKEN=

# Your own email address. Sessions email you here, and they only accept email sent from it.
OMP_EMAIL_OWNER=you@example.com

# The domain you verified in Mailtrap for sending and receiving, for example agents.example.com.
OMP_EMAIL_DOMAIN=agents.example.com

# ID of the Mailtrap inbound inbox that catches every address on that domain (*@agents.example.com).
OMP_EMAIL_INBOX_ID=

# Optional: how often each session checks the inbox, in seconds. Default 15, minimum 5.
# OMP_EMAIL_POLL_SECONDS=15
